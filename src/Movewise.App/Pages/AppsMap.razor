@page "/apps/map"
@inject MigrationState State
@inject ApplicationsState Apps
@inject ApplicationsService Applications
@implements IDisposable

<div class="page">
    <header class="page-head">
        <div class="head-row">
            <div class="head-text">
                <h1>Map users &amp; groups</h1>
                <p class="muted">The users and groups the chosen apps are assigned to, and their owners. Match each one to its counterpart in @DestinationName.</p>
            </div>
            @if (Plan is not null && !busy)
            {
                <div class="head-actions">
                    <button class="btn ghost" @onclick="BuildAsync">Match again</button>
                </div>
            }
        </div>
        <StepBar Current="2" Applications="true" />
    </header>

    <div class="content">
        @if (!State.ReadyToDiscover || Apps.Selected.Count == 0)
        {
            <div class="alert warn">Choose the apps to migrate first. <a href="apps">Go to Choose apps</a></div>
        }
        else if (busy)
        {
            <div class="card pad" role="status">@progress</div>
        }
        else if (error is not null)
        {
            <div class="alert bad" role="alert">@error</div>
        }
        else if (Plan is not null)
        {
            if (message is not null)
            {
                <div class="alert warn" role="status">@message</div>
            }

            if (Plan.Items.Count == 0)
            {
                <div class="card pad">The chosen apps have no users, groups or owners to match. There's nothing to map.</div>
            }
            else
            {
                <div class="tabs" role="tablist" aria-label="Object types">
                    @foreach (var type in Types)
                    {
                        var all = Plan.OfType(type).ToList();
                        var resolved = all.Count(m => m.IsResolved);
                        <button type="button" role="tab" id="tab-@type" class="tab @(type == tab ? "on" : "")" aria-selected="@(type == tab ? "true" : "false")"
                                aria-controls="map-panel" tabindex="@(type == tab ? 0 : -1)" @onclick="@(() => SelectTab(type))">
                            <b>@MappingNames.Plural(type)</b>
                            <span class="@(resolved == all.Count ? "ok-text" : "warn-text")">@resolved of @all.Count matched</span>
                        </button>
                    }
                </div>

                <div class="map-body" role="tabpanel" id="map-panel" aria-labelledby="tab-@tab">
                    <section class="card table map-table">
                        <div class="row head">
                            <span>In @SourceName</span><span></span><span>In @DestinationName</span><span>Match</span><span class="num">Apps</span>
                        </div>
                        @foreach (var mapping in Plan.OfType(tab))
                        {
                            var isSelected = selected?.Key == mapping.Key;
                            <button type="button" class="row selectable @(isSelected ? "selected" : "") @(mapping.IsResolved ? "" : "unresolved")"
                                    aria-pressed="@(isSelected ? "true" : "false")" @onclick="@(() => Select(mapping))">
                                <span class="stack">
                                    <span class="strong">@mapping.Source.DisplayName</span>
                                    @if (mapping.Source.Detail is not null && mapping.Source.Detail != mapping.Source.DisplayName)
                                    {
                                        <span class="mono muted small">@mapping.Source.Detail</span>
                                    }
                                </span>
                                <span class="muted" aria-hidden="true">→</span>
                                <span class="stack">@DestinationText(mapping)</span>
                                <span><span class="pill @PillClass(mapping.Kind)">@Describe(mapping.Kind)</span></span>
                                <span class="num">@mapping.UsedBy.Count</span>
                            </button>
                        }
                    </section>

                    <aside class="card side" aria-label="Selected object">
                        @if (selected is null)
                        {
                            <p class="muted">Select a row to change how it's matched.</p>
                        }
                        else
                        {
                            <div class="stack">
                                <span class="label">@MappingNames.Singular(selected.TargetType)</span>
                                <span class="side-title">@selected.Source.DisplayName</span>
                                @if (selected.Source.Detail is not null)
                                {
                                    <span class="mono muted small">@selected.Source.Detail</span>
                                }
                            </div>

                            @if (selected.Note is not null)
                            {
                                <div class="check warn">@selected.Note</div>
                            }

                            <div class="stack">
                                <span class="small strong">Assigned to or owns @selected.UsedBy.Count app@(selected.UsedBy.Count == 1 ? "" : "s")</span>
                                @foreach (var app in selected.UsedBy.Take(6))
                                {
                                    <span class="small muted">@app</span>
                                }
                                @if (selected.UsedBy.Count > 6)
                                {
                                    <span class="small muted">and @(selected.UsedBy.Count - 6) more</span>
                                }
                            </div>

                            <div class="stack">
                                <span class="small strong">In @DestinationName</span>
                                <span><span class="pill @PillClass(selected.Kind)">@Describe(selected.Kind)</span> @DestinationText(selected)</span>
                            </div>

                            <div class="stack">
                                <label class="small strong" for="map-search">Match to an existing @MappingNames.Singular(selected.TargetType).ToLowerInvariant()</label>
                                <div class="search-row">
                                    <input id="map-search" class="input" @bind="searchText" @bind:event="oninput" @onkeydown="SearchOnEnter" placeholder="Start of the name" />
                                    <button class="btn ghost" disabled="@searching" @onclick="SearchAsync">@(searching ? "Searching…" : "Search")</button>
                                </div>
                                @if (results is not null)
                                {
                                    <div class="results">
                                        @if (results.Count == 0)
                                        {
                                            <span class="small muted">Nothing in @DestinationName starts with that.</span>
                                        }
                                        @foreach (var result in results)
                                        {
                                            <button type="button" class="result" @onclick="@(() => Decide(m => m.MapTo(result)))">
                                                <span class="strong">@result.DisplayName</span>
                                                @if (result.Detail is not null)
                                                {
                                                    <span class="mono muted small">@result.Detail</span>
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="stack">
                                <button class="btn ghost" disabled="@(selected.Kind == MatchKind.RemoveFromPolicies)" @onclick="@(() => Decide(m => m.RemoveFromPolicies()))">Leave it out</button>
                                <span class="small muted">It won't be assigned to the apps, or made their owner, in @DestinationName.</span>
                                @if (selected.IsDecision)
                                {
                                    <button class="btn link" @onclick="@(() => Decide(m => m.Clear()))">Undo my choice</button>
                                }
                            </div>
                        }
                    </aside>
                </div>
            }
        }
    </div>

    <footer class="page-foot">
        <span class="@(UnresolvedCount > 0 ? "warn-text" : "muted")">
            @(Plan is null ? "" : UnresolvedCount > 0 ? $"{UnresolvedCount} still unresolved. Pre-flight will block the apps that use them." : "Everything is matched.")
        </span>
        <div class="head-actions">
            <a class="btn ghost" href="apps">Back</a>
            <a class="btn primary @(Plan is null || busy ? "disabled" : "")" href="apps/preflight" aria-disabled="@(Plan is null || busy ? "true" : "false")">
                Run pre-flight checks
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
        </div>
    </footer>
</div>

@code {
    bool busy;
    bool searching;
    string progress = "";
    string? error;
    string? message;
    string tab = "";
    Mapping? selected;
    string searchText = "";
    IReadOnlyList<ObjectRef>? results;

    MappingPlan? Plan => Apps.Mapping;
    int UnresolvedCount => Plan?.UnresolvedCount ?? 0;
    string SourceName => State.Source?.Info.DisplayName ?? "the source";
    string DestinationName => State.Destination?.Info.DisplayName ?? "the destination";
    IEnumerable<string> Types => new[] { ResourceRegistry.Group, ResourceRegistry.User }.Where(t => Plan?.OfType(t).Any() == true);

    protected override async Task OnInitializedAsync()
    {
        Apps.Changed += OnStateChanged;
        if (State.ReadyToDiscover && Apps.Selected.Count > 0 && !Apps.MappingIsCurrent)
            await BuildAsync();
        else
            PickTab();
    }

    async Task BuildAsync()
    {
        busy = true;
        error = null;
        message = null;
        progress = "Matching users and groups in the destination…";
        try
        {
            await Applications.BuildMappingAsync(new Progress<string>(text =>
            {
                progress = text;
                InvokeAsync(StateHasChanged);
            }));
        }
        catch (Exception ex)
        {
            error = $"Couldn't match users and groups in the destination. {ex.Message}";
        }
        finally
        {
            busy = false;
        }

        selected = selected is null ? null : Plan?.Find(selected.TargetType, selected.Source.Id);
        PickTab();
    }

    void PickTab()
    {
        if (Plan is null || Types.Contains(tab))
            return;
        tab = Types.FirstOrDefault(t => Plan.OfType(t).Any(m => !m.IsResolved)) ?? Types.FirstOrDefault() ?? "";
    }

    void SelectTab(string type)
    {
        tab = type;
        selected = null;
        results = null;
    }

    void Select(Mapping mapping)
    {
        selected = mapping;
        searchText = mapping.Source.DisplayName;
        results = null;
    }

    async Task SearchOnEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    async Task SearchAsync()
    {
        if (selected is null)
            return;
        searching = true;
        message = null;
        try
        {
            results = await Applications.SearchDestinationAsync(selected.TargetType, searchText);
        }
        catch (Exception ex)
        {
            results = null;
            message = $"Search failed. {ex.Message}";
        }
        finally
        {
            searching = false;
        }
    }

    void Decide(Action<Mapping> decide)
    {
        if (selected is null)
            return;
        results = null;
        decide(selected);
        Apps.NotifyChanged();
    }

    static string Describe(MatchKind kind) => kind == MatchKind.RemoveFromPolicies ? "Left out" : MappingNames.Describe(kind);

    static string DestinationText(Mapping mapping) => mapping.Kind switch
    {
        MatchKind.Unresolved => "Choose a match…",
        MatchKind.RemoveFromPolicies => "Not assigned or made owner",
        _ => mapping.Destination?.DisplayName ?? "",
    };

    static string PillClass(MatchKind kind) => kind switch
    {
        MatchKind.Unresolved => "bad",
        MatchKind.RemoveFromPolicies => "warn",
        MatchKind.Manual => "info",
        _ => "ok",
    };

    void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Apps.Changed -= OnStateChanged;
}
