@page "/"
@inject MigrationState State
@inject MigrationService Migration
@inject MovewiseOptions Options
@inject NavigationManager Nav
@implements IDisposable

<div class="page">
    <header class="page-head">
        <div class="head-row">
            <div class="head-text">
                <h1>Connect source and destination</h1>
                <p class="muted">Sign in to the destination first, then the source, each with an admin account that belongs to that tenant. No policies change in either tenant until you deploy.</p>
            </div>
        </div>
        <StepBar Current="1" />
    </header>

    <div class="content">
        @if (IsDemo)
        {
            <div class="demo-banner" role="status">
                <span><b>You're using the demo tenants.</b> Contoso and Fabrikam are made up and live only inside Movewise: deploying and rolling back change nothing real.</span>
                <button class="btn ghost small-btn" disabled="@Migration.IsWorking" @onclick="LeaveDemoAsync">Leave the demo</button>
            </div>
        }
        else
        {
            @* The app registration is set up during the destination sign-in. Only gaps are shown here. *@
            @if (Migration.LastSetup is { Notes.Count: > 0 } setup)
            {
                <div class="alert warn" role="status">
                    <b>Movewise is set up in @setup.Tenant, with some gaps:</b>
                    <ul>
                        @foreach (var note in setup.Notes)
                        {
                            <li>@note</li>
                        }
                    </ul>
                </div>
            }
            @if (State.Source is null && State.Destination is null)
            {
                <div class="demo-offer">
                    <div class="stack">
                        <b>No tenants to hand?</b>
                        <span class="muted small">Try Movewise with two built-in demo tenants, Contoso and Fabrikam. Every step works, including deploying and rolling back, and nothing leaves this PC. No app registration needed.</span>
                    </div>
                    <button class="btn ghost" disabled="@Migration.IsWorking" @onclick="StartDemoAsync">Try the demo</button>
                </div>
            }
        }

        @if (State.Destination is not null && State.Source is null && !IsDemo && baselines.Count > 0)
        {
            <section class="card baseline-picker" aria-label="Saved baselines">
                <div class="card-head">
                    <h2>Or use a saved baseline as the source</h2>
                    <span class="muted small">Apply a template's policies to this tenant without signing in to the template.</span>
                </div>
                <ul class="baseline-list">
                    @foreach (var baseline in baselines)
                    {
                        <li>
                            <span class="stack">
                                <b>@baseline.Name</b>
                                <span class="muted small">@baseline.Items.Count policies · saved @baseline.Saved.LocalDateTime.ToString("d MMM yyyy HH:mm") from @baseline.TenantName</span>
                            </span>
                            <button class="btn ghost" disabled="@Migration.IsWorking" @onclick="@(() => UseBaselineAsync(baseline))">Use as source</button>
                        </li>
                    }
                </ul>
                @if (baselineError is not null)
                {
                    <div class="alert bad" role="alert">@baselineError</div>
                }
            </section>
        }

        <div class="tenants">
            <TenantCard Role="TenantRole.Source" />
            <div class="arrow" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </div>
            <TenantCard Role="TenantRole.Destination" />
        </div>

        <section class="card">
            <div class="card-head">
                <h2>What this build can migrate</h2>
                <span class="muted small">Built-in and default policies stay as they are in the destination.</span>
            </div>
            <div class="services">
                @foreach (var service in Services)
                {
                    var chosen = State.Services.Contains(service.Service);
                    <label class="service @(chosen ? "on" : "")">
                        <input type="checkbox" checked="@chosen" disabled="@Migration.IsWorking" @onchange="@(e => ToggleService(service.Service, e.Value is true))" />
                        <span class="stack">
                            <b>@service.Name</b>
                            <span class="muted small">@service.What</span>
                        </span>
                    </label>
                }
            </div>
        </section>
    </div>

    <footer class="page-foot">
        <span class="muted">@FooterHint</span>
        <button class="btn primary" disabled="@(!State.ReadyToDiscover || State.Services.Count == 0)" @onclick="@(() => Nav.NavigateTo("discover"))">
            Discover policies
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </button>
    </footer>
</div>

@code {
    record ServiceInfo(M365Service Service, string Name, string What);

    static readonly ServiceInfo[] Services =
    [
        new(M365Service.Entra, "Entra ID", "Conditional Access, sign-in methods, named locations, roles"),
        new(M365Service.Intune, "Intune", "Configuration, compliance, app protection, Autopilot"),
        new(M365Service.Purview, "Purview", "DLP, retention, sensitivity labels, alert policies"),
        new(M365Service.Defender, "Defender for Office 365", "Anti-phishing, anti-spam, Safe Links, Safe Attachments"),
        new(M365Service.Exchange, "Exchange Online", "Mail flow rules, org config, DKIM"),
        new(M365Service.Teams, "Teams", "Meeting, messaging and app policies"),
        new(M365Service.SharePoint, "SharePoint and OneDrive", "Sharing and access control settings"),
        new(M365Service.DefenderEndpoint, "Defender for Endpoint", "Indicators, custom detection rules"),
    ];

    void ToggleService(M365Service service, bool on)
    {
        if (on) State.Services.Add(service);
        else State.RemoveService(service);
        State.NotifyChanged();
    }

    string FooterHint =>
        State.ReadyToDiscover && State.Services.Count == 0 ? "Choose at least one service to continue."
        : State.Source is not null && State.Destination is not null ? (IsDemo ? "Both demo tenants are connected." : "Both tenants are connected. Nothing has been changed.")
        : State.Destination is null && !Migration.RegistrationIsManaged ? "Sign in to the destination tenant first: that sets Movewise up."
        : State.Destination is null ? "Sign in to the destination tenant to continue."
        : "Now sign in to the source tenant.";

    bool IsDemo => Migration.IsDemo;

    Task StartDemoAsync() => Migration.ConnectDemoAsync();

    // Signing out of either demo tenant leaves the demo altogether.
    Task LeaveDemoAsync() => Migration.DisconnectAsync(TenantRole.Destination);

    IReadOnlyList<Movewise.Core.Baselines.Baseline> baselines = [];
    string? baselineError;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        // Demo baselines stay with the demo: a real tenant is never given one, and the demo never gets a real one.
        baselines = (await Migration.ListBaselinesAsync()).Where(b => !b.IsDemo).ToList();
    }

    async Task UseBaselineAsync(Movewise.Core.Baselines.Baseline baseline)
    {
        baselineError = null;
        try
        {
            await Migration.UseBaselineAsync(baseline);
            Nav.NavigateTo("discover");
        }
        catch (Exception ex)
        {
            baselineError = $"Couldn't use the baseline. {ex.Message}";
        }
    }

    void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnStateChanged;
}
