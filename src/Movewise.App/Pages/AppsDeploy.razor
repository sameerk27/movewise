@page "/apps/deploy"
@using System.Diagnostics
@using System.IO
@using Movewise.Core.Deploy
@using Movewise.Core.Preflight
@inject MigrationState State
@inject ApplicationsState Apps
@inject ApplicationsService Applications
@inject MigrationService Migration
@implements IDisposable

<div class="page">
    <header class="page-head">
        <div class="head-row">
            <div class="head-text">
                <h1>Deploy applications</h1>
                <p class="muted">
                    @if (Run is null)
                    {
                        <text>Create the chosen apps in @DestinationName, then give their users, groups and owners access. The source tenant is only read, never changed.</text>
                    }
                    else
                    {
                        <text>Run @Run.RunId · @Run.SourceName → @Run.DestinationName · started @Run.Started.ToString("d MMM yyyy HH:mm")</text>
                    }
                </p>
            </div>
            @if (Run is not null)
            {
                <span class="pill big @RunClass" role="status">@RunText</span>
            }
        </div>
        <StepBar Current="4" Applications="true" />
    </header>

    <div class="content">
        @if (error is not null)
        {
            <div class="alert bad" role="alert">@error</div>
        }
        @if (message is not null)
        {
            <div class="alert ok" role="status">@message</div>
        }

        @if (State.Destination is null)
        {
            <div class="alert warn">Sign in to the destination tenant first. <a href="">Go to Connect</a></div>
        }
        else if (Applications.IsPreparing)
        {
            <div class="card pad" role="status">@Applications.BusyText</div>
        }
        else if (Run is null)
        {
            @if (Report is null || !Report.CanDeploy)
            {
                <div class="alert warn">
                    @(Report is null ? "Run the pre-flight checks first." : Report.HasBlockers && !Report.BlockedSkipped ? "Pre-flight found blockers. Fix them before deploying." : "There's nothing to do.")
                    <a href="apps/preflight">Go to Pre-flight</a>
                </div>
            }
            else
            {
                <section class="card deploy-start">
                    <h2>Ready to migrate @(Report.CreateCount + Report.UpdateCount) app@(Report.CreateCount + Report.UpdateCount == 1 ? "" : "s") to @DestinationName</h2>
                    <ul class="plan-list">
                        @if (Report.CreateCount > 0)
                        {
                            <li>@Report.CreateCount app@(Report.CreateCount == 1 ? " is" : "s are") created first: enterprise apps for the same app ID, app registrations with a new one.</li>
                        }
                        @if (Report.UpdateCount > 0)
                        {
                            <li>@Report.UpdateCount app@(Report.UpdateCount == 1 ? " that's" : "s that are") already there get their settings changed to match. Nothing is taken away.</li>
                        }
                        @if (Report.Apps.Any(a => a.Outcome == Outcome.Create && a.UsesSaml && a.IsOwnApp && !a.IsUpdate))
                        {
                            <li>SAML apps get their single sign-on and claims, and a new signing certificate.</li>
                        }
                        <li>Then owners and @Report.AssignmentCount user and group assignment@(Report.AssignmentCount == 1 ? "" : "s"), each with its app role.</li>
                        @if (Report.BlockedSkipped && Report.BlockedCount > 0)
                        {
                            <li>@Report.BlockedCount blocked app@(Report.BlockedCount == 1 ? " is" : "s are") left out, as you chose in pre-flight.</li>
                        }
                        <li>API permissions aren't granted. An admin grants consent after checking each app.</li>
                        <li>Pre-flight runs once more first, in case the destination changed.</li>
                        <li>Progress is saved after every app, owner and assignment. If anything stops the run, open it again here to finish it or roll it back.</li>
                    </ul>
                    <div class="actions">
                        <button class="btn primary" disabled="@(Migration.IsWorking || Migration.IsUpdating)" @onclick="StartAsync">Deploy now</button>
                    </div>
                </section>
            }

            @if (previousRuns.Count > 0)
            {
                <section class="card table runs">
                    <div class="row head"><span>Earlier app runs into @DestinationName</span><span>From</span><span>In destination</span><span>Status</span><span></span></div>
                    @foreach (var summary in previousRuns)
                    {
                        <div class="row">
                            <span>@summary.Started.ToString("d MMM yyyy HH:mm") <span class="muted small mono">@summary.RunId</span></span>
                            <span>@summary.SourceName</span>
                            <span>@summary.Created app@(summary.Created == 1 ? "" : "s")</span>
                            <span>
                                @if (summary.RolledBack)
                                {
                                    <span class="pill neutral">Rolled back</span>
                                }
                                else if (summary.Remaining > 0)
                                {
                                    <span class="pill warn">@summary.Remaining unfinished</span>
                                }
                                else
                                {
                                    <span class="pill ok">Finished</span>
                                }
                            </span>
                            <span><button class="btn ghost small-btn" @onclick="@(() => Open(summary))">Open</button></span>
                        </div>
                    }
                </section>
            }
        }
        else
        {
            var total = Run.Steps.Count;
            var finished = Run.Steps.Count(s => s.Status is not (StepStatus.Pending or StepStatus.Creating or StepStatus.Created));

            @if (Applications.IsBusy)
            {
                <div class="card pad progress-card" role="status" aria-live="polite">
                    <span>@Applications.BusyText</span>
                    <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="@total" aria-valuenow="@finished">
                        <span style="width:@(total == 0 ? 0 : finished * 100 / total)%"></span>
                    </div>
                    <span class="muted small">Windows won't sleep while this runs. Stopping finishes the current request first.</span>
                </div>
            }

            @if (confirmRollback)
            {
                <div class="alert bad confirm" role="alertdialog" aria-labelledby="rollback-title">
                    <b id="rollback-title">@RollbackQuestion</b>
                    <span>Only what this run made is taken out; everything that was there before stays. Deleted apps can be restored from Entra ID's deleted apps for 30 days, but their assignments can't.</span>
                    <div class="actions">
                        <button class="btn danger" @onclick="RollbackAsync">Roll back</button>
                        <button class="btn ghost" @onclick="@(() => confirmRollback = false)">Cancel</button>
                    </div>
                </div>
            }

            <div class="stats four">
                <div class="card stat"><b class="ok-text">@Run.DoneCount</b><span class="muted">done</span></div>
                <div class="card stat"><b class="@(Run.FailedCount > 0 ? "bad-text" : "")">@Run.FailedCount</b><span class="muted">failed</span></div>
                <div class="card stat"><b class="@(Run.SkippedCount > 0 ? "warn-text" : "")">@Run.SkippedCount</b><span class="muted">skipped</span></div>
                <div class="card stat"><b>@Run.RemainingCount</b><span class="muted">unfinished</span></div>
            </div>

            <section class="card table deploy-table">
                <div class="row head"><span>Application</span><span>Type</span><span>Status</span><span>Details</span></div>
                @foreach (var step in Run.Steps)
                {
                    <div class="row">
                        <span class="stack">
                            <span class="strong">@step.DisplayName</span>
                            @if (step.AppId is not null)
                            {
                                <span class="muted small mono">app ID @step.AppId</span>
                            }
                            else if (step.DestinationId is not null)
                            {
                                <span class="muted small mono">@step.DestinationId</span>
                            }
                        </span>
                        <span class="muted small">@step.TypeName@(step.UpdateOf is not null ? " · updated" : "")</span>
                        <span><span class="pill @StatusClass(step)">@StatusText(step)</span></span>
                        <span class="small">
                            @if (step.Message is not null)
                            {
                                <span class="@(step.Status is StepStatus.Failed or StepStatus.RollbackFailed ? "bad-text" : "muted")">@step.Message</span>
                            }
                            @foreach (var note in step.Notes)
                            {
                                <span class="warn-text note">@note</span>
                            }
                        </span>
                    </div>
                }
            </section>

            @if (Run.Completed is not null && Run.RolledBack is null && !PartlyRolledBack && !Applications.IsBusy && Run.DoneCount > 0)
            {
                <section class="card">
                    <h2>After deploying</h2>
                    <ul class="plan-list">
                        <li>Grant the apps' API permissions in @Run.DestinationName once you've checked them (Enterprise apps → the app → Permissions). Pre-flight listed them; Movewise didn't grant any.</li>
                        @if (Run.Steps.Any(s => s.Status == StepStatus.Done && s.Body["saml"] is not null && s.UpdateOf is null))
                        {
                            <li>Give each SAML app's vendor its new signing certificate, or the app's new federation metadata, before moving users over. The thumbprints are listed above.</li>
                        }
                        <li>Set up by hand what pre-flight listed: client secrets and certificates, provisioning, apps to add from the gallery.</li>
                        <li>Members of new or matched groups get the apps through their groups: check the groups have the right members.</li>
                        <li>Keep the results file with your change records. It lists every app's ID in @Run.DestinationName.</li>
                    </ul>
                </section>
            }
        }
    </div>

    <footer class="page-foot">
        <div class="head-actions">
            @if (Run is not null)
            {
                <button class="btn ghost" @onclick="DownloadResults">Download results</button>
                <button class="btn ghost" disabled="@(Run.Folder is null)" @onclick="OpenFolder">Open run folder</button>
            }
        </div>
        <div class="head-actions">
            @if (Run is null)
            {
                <a class="btn ghost" href="apps/preflight">Back</a>
            }
            else if (Applications.IsBusy)
            {
                <button class="btn ghost" disabled="@stopping" @onclick="Stop">@(stopping ? "Stopping…" : "Stop")</button>
            }
            else
            {
                <button class="btn ghost" @onclick="Close">@(Run.RolledBack is null && Run.RemainingCount > 0 ? "Close run" : "New deployment")</button>
                @if (Run.CanRollBack && !confirmRollback)
                {
                    <button class="btn ghost danger-text" @onclick="@(() => confirmRollback = true)">Roll back this run</button>
                }
                @if (Run.RemainingCount > 0)
                {
                    <button class="btn primary" @onclick="ResumeAsync">@(Run.Steps.Any(s => s.Status != StepStatus.Pending) ? $"Retry {Run.RemainingCount} unfinished" : "Start")</button>
                }
                else if (Run.RolledBack is null && !PartlyRolledBack)
                {
                    <a class="btn primary" href="">Migrate the policies</a>
                }
            }
        </div>
    </footer>
</div>

@code {
    bool stopping;
    bool confirmRollback;
    string? error;
    string? message;
    IReadOnlyList<RunSummary> previousRuns = [];

    DeployRun? Run => Apps.Run;
    AppPreflightReport? Report => Apps.Preflight;
    string DestinationName => State.Destination?.Info.DisplayName ?? "the destination";

    bool PartlyRolledBack => Run!.RolledBack is null && Run.Steps.Any(s => s.Status is StepStatus.RolledBack or StepStatus.RollbackFailed);

    string RunText => Applications.IsBusy ? "Running"
        : Run!.RolledBack is not null ? "Rolled back"
        : PartlyRolledBack ? "Partly rolled back"
        : Run.FailedCount > 0 ? $"{Run.FailedCount} failed"
        : Run.RemainingCount > 0 ? "Not finished"
        : "Deployed";

    string RunClass => Applications.IsBusy ? "info"
        : Run!.RolledBack is not null ? "neutral"
        : PartlyRolledBack ? "warn"
        : Run.FailedCount > 0 ? "bad"
        : Run.RemainingCount > 0 ? "warn"
        : "ok";

    int Updated => Run?.Steps.Count(s => s.UpdateOf is not null && s.ExistsInDestination) ?? 0;

    string RollbackQuestion
    {
        get
        {
            var created = Run!.CreatedInDestination - Updated;
            var parts = new List<string>();
            if (created > 0) parts.Add($"delete the {created} app{(created == 1 ? "" : "s")} this run created");
            if (Updated > 0) parts.Add($"put back the {Updated} app{(Updated == 1 ? "" : "s")} it updated");
            return parts.Count == 0 ? "Roll back this run?" : $"In {Run.DestinationName}, {string.Join(", and ", parts)}?";
        }
    }

    protected override void OnInitialized()
    {
        Apps.Changed += OnStateChanged;
        State.Changed += OnStateChanged;
        LoadPreviousRuns();
    }

    void LoadPreviousRuns()
    {
        try
        {
            previousRuns = Applications.PreviousRuns();
        }
        catch (Exception ex)
        {
            error = $"Couldn't list earlier runs. {ex.Message}";
        }
    }

    async Task StartAsync()
    {
        if (Migration.IsWorking)
            return;
        error = null;
        message = null;
        try
        {
            await Applications.PrepareDeploymentAsync(new Progress<string>(_ => InvokeAsync(StateHasChanged)));
        }
        catch (Exception ex)
        {
            error = ex.Message;
            return;
        }

        await ResumeAsync();
    }

    async Task ResumeAsync()
    {
        error = null;
        message = null;
        try
        {
            await Applications.DeployAsync();
            message = Run!.FailedCount == 0 && Run.RemainingCount == 0
                ? $"Done. {Run.DoneCount} app{(Run.DoneCount == 1 ? "" : "s")} migrated to {Run.DestinationName}."
                : null;
        }
        catch (OperationCanceledException)
        {
            message = "Stopped. Retry to finish the run, or roll it back.";
        }
        catch (Exception ex)
        {
            error = $"The deployment stopped. {ex.Message}";
        }
        finally
        {
            stopping = false;
        }
    }

    async Task RollbackAsync()
    {
        confirmRollback = false;
        error = null;
        message = null;
        try
        {
            await Applications.RollbackAsync();
            if (Run!.RolledBack is not null)
                message = $"Rolled back. What this run made in {Run.DestinationName} has been taken out.";
            else
                error = "Some apps couldn't be rolled back. They're marked below; try again, or fix them in the admin center.";
        }
        catch (OperationCanceledException)
        {
            message = "Rollback stopped. Roll back again to finish.";
        }
        catch (Exception ex)
        {
            error = $"The rollback stopped. {ex.Message}";
        }
        finally
        {
            stopping = false;
        }
    }

    void Stop()
    {
        stopping = true;
        Applications.Stop();
    }

    void Open(RunSummary summary)
    {
        error = null;
        message = null;
        try
        {
            Applications.OpenRun(summary.Path);
        }
        catch (Exception ex)
        {
            error = $"Couldn't open that run. {ex.Message}";
        }
    }

    void Close()
    {
        error = null;
        message = null;
        confirmRollback = false;
        Applications.CloseRun();
        LoadPreviousRuns();
    }

    void DownloadResults()
    {
        if (Run is null)
            return;
        var path = FileDialogs.SaveCsv("Save deployment results", $"Movewise app deployment {Run.RunId}.csv");
        if (path is null)
            return;
        error = null;
        try
        {
            File.WriteAllText(path, DeployReportCsv.Write(Run));
            message = $"Saved the results to {path}.";
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            message = null;
            error = $"Couldn't save the results. If the file is open in Excel, close it and try again. ({ex.Message})";
        }
    }

    void OpenFolder()
    {
        if (Run?.Folder is { } folder && Directory.Exists(folder))
            Process.Start(new ProcessStartInfo("explorer.exe", $"\"{folder}\"") { UseShellExecute = true });
    }

    string StatusText(DeployStep step) => step.Status switch
    {
        StepStatus.Pending => "Waiting",
        StepStatus.Creating => step.Message is not null ? "Unknown" : Applications.IsBusy ? "Creating…" : "Interrupted",
        StepStatus.Created => Applications.IsBusy ? "Waiting for access" : "No access yet",
        StepStatus.Done => "Done",
        StepStatus.Failed => "Failed",
        StepStatus.Skipped => "Skipped",
        StepStatus.RolledBack => "Rolled back",
        _ => "Rollback failed",
    };

    static string StatusClass(DeployStep step) => step.Status switch
    {
        StepStatus.Done => "ok",
        StepStatus.Failed or StepStatus.RollbackFailed => "bad",
        StepStatus.Skipped => "warn",
        StepStatus.Creating when step.Message is not null => "warn",
        StepStatus.Creating or StepStatus.Created => "info",
        _ => "neutral",
    };

    void OnStateChanged() => InvokeAsync(() =>
    {
        if (!Applications.IsBusy)
            stopping = false;
        StateHasChanged();
    });

    public void Dispose()
    {
        Apps.Changed -= OnStateChanged;
        State.Changed -= OnStateChanged;
    }
}
