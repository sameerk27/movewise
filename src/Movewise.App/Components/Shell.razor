@inherits LayoutComponentBase
@inject MigrationState State
@inject MigrationService Migration
@inject UpdateService Updates
@inject NavigationManager Navigation
@implements IDisposable

<div class="app">
    <aside class="sidebar">
        <div class="brand">
            <svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <rect x="2" y="6" width="8" height="14" rx="2"></rect><rect x="16" y="6" width="8" height="14" rx="2"></rect><path d="M10 13h6"></path>
            </svg>
            <span>Movewise</span>
        </div>
        <nav class="nav" aria-label="Main">
            @* Every migration step lives at the root ("", discover, map…); the other screens have their own routes. *@
            <a href="" class="@(InMigration ? "on" : "")">Migrations</a>
            <a href="compare" class="@(SectionOf("compare") ? "on" : "")">Compare</a>
            <a href="snapshots" class="@(SectionOf("snapshots") ? "on" : "")">Snapshots</a>
            <a href="baselines" class="@(SectionOf("baselines") ? "on" : "")">Baselines</a>
            <a href="drift" class="@(SectionOf("drift") ? "on" : "")">Drift monitor</a>
        </nav>
        <div class="sidebar-foot">
            <div class="side-tenant">
                <span class="side-label">Source</span>
                <span>@(State.Source?.Info.DisplayName ?? "Not connected")</span>
            </div>
            <div class="side-tenant">
                <span class="side-label">Destination</span>
                <span>@(State.Destination?.Info.DisplayName ?? "Not connected")</span>
            </div>
            @if (Updates.AvailableVersion is { } version)
            {
                <button class="side-update" disabled="@(Migration.IsWorking || Updates.IsUpdating)" @onclick="UpdateAsync"
                        title="@(Migration.IsWorking ? "Available once the deployment finishes" : "Downloads the update and restarts Movewise")">
                    @(Updates.IsUpdating ? "Updating…" : $"Update to {version}")
                </button>
            }
            @if (message is not null)
            {
                <span class="side-note" role="status">@message</span>
            }
            <div class="side-meta">
                <span>Version @DiagnosticLog.Version</span>
                <button class="side-link" @onclick="SaveSupportLog">Save support log</button>
            </div>
        </div>
    </aside>
    <main class="main">@Body</main>
</div>

@code {
    string? message;

    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
        Updates.Changed += OnStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    async Task UpdateAsync()
    {
        message = null;
        try
        {
            await Updates.ApplyAsync();
        }
        catch (Exception ex)
        {
            message = $"The update didn't finish: {ex.Message}";
        }
    }

    void SaveSupportLog()
    {
        message = null;
        var path = FileDialogs.SaveZip("Save support log", $"Movewise support log {DateTime.Now:yyyy-MM-dd HHmm}.zip");
        if (path is null)
            return;
        try
        {
            DiagnosticLog.SaveSupportBundle(path);
            message = "Saved. Tokens, email addresses, domains, IP addresses and IDs are taken out. Tenant and policy names can still appear in it.";
        }
        catch (Exception ex)
        {
            message = $"Couldn't save the log: {ex.Message}";
        }
    }

    // Compare has its own entry, and is also reached from Snapshots, Drift and the end of a deployment.
    static readonly string[] OutsideMigration = ["snapshots", "compare", "baselines", "drift"];

    bool SectionOf(params string[] sections)
    {
        var first = Navigation.ToBaseRelativePath(Navigation.Uri).Split('/', 2)[0];
        return sections.Contains(first, StringComparer.OrdinalIgnoreCase);
    }

    // Migration steps live at the root, so "Migrations" is on everywhere the other sections aren't.
    bool InMigration => !SectionOf(OutsideMigration);

    void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
        Updates.Changed -= OnStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
