<nav class="steps" aria-label="@(Applications ? "Application migration steps" : "Migration steps")">
    @for (var i = 0; i < Steps.Length; i++)
    {
        var (name, href) = Steps[i];
        var number = i + 1;
        var css = number < Current ? "step done" : number == Current ? "step cur" : "step";

        if (i > 0)
        {
            <span class="bar @(number <= Current ? "done" : "")"></span>
        }

        if (href is not null && number <= Current)
        {
            <a class="@css" href="@href" aria-current="@(number == Current ? "step" : null)">
                <span class="dot">@if (number < Current) { <Check /> } else { @number }</span>@name
            </a>
        }
        else
        {
            <span class="@css" aria-disabled="true">
                <span class="dot">@number</span>@name
            </span>
        }
    }
</nav>

@code {
    [Parameter, EditorRequired] public int Current { get; set; }

    /// <summary>The Applications section's own steps rather than the policy migration's.</summary>
    [Parameter] public bool Applications { get; set; }

    (string Name, string? Href)[] Steps => Applications ? AppSteps : PolicySteps;

    // A step links back only once it's been reached.
    static readonly (string Name, string? Href)[] AppSteps =
    [
        ("Choose apps", "apps"),
        ("Map users & groups", "apps/map"),
        ("Pre-flight", "apps/preflight"),
        ("Deploy", "apps/deploy"),
    ];

    static readonly (string Name, string? Href)[] PolicySteps =
    [
        ("Connect", ""),
        ("Discover", "discover"),
        ("Map dependencies", "map"),
        ("Pre-flight", "preflight"),
        ("Deploy", "deploy"),
    ];
}
